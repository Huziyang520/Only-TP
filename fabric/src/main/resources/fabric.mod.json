{
    "schemaVersion": 1,
    "id": "onlytp",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "[EN] Restrict players to TP-related commands only, or block all non-TP commands.\n[CN] 限制玩家仅可使用与传送（TP）相关的指令，或禁止所有非 TP 指令。",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/only-tp",
        "issues": "https://github.com/Huziyang520/Only-TP/issues"
    },
    "license": "${license}",
    "icon": "assets/onlytp/textures/onlytp.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.onlytp.onlytpmod.OnlyTPMod"
        ],
        "client": [
            "com.onlytp.onlytpmod.client.OnlyTPClient"
        ],
        "modmenu": [
            "com.onlytp.onlytpmod.client.ModMenuConfigEntry"
        ]
    },
    "mixins": [
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric-api": "*",
        "minecraft": ">=26.3",
        "java": ">=25"
    },
    "suggests": {
        "avalonbase": ">=1.0.0"
    },
    "custom": {
        "catalogue": {
            "configFactory": "com.onlytp.onlytpmod.client.CatalogueConfigEntry"
        },
        "modmenu": {
            "links": {
                "onlytp.feedback": "https://issue.mengcai.online/"
                }
            }
    }
}